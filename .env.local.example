MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
NEXTAUTH_SECRET=<run: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=your@email.com
RESEND_API_KEY=re_<your Resend API key from resend.com>
FROM_EMAIL=noreply@yourdomain.com
GEMINI_API_KEY=<Google AI Studio key>
PERPLEXITY_API_KEY=<Perplexity API key>
KIMI_API_KEY=<Moonshot Kimi key>
# AI tools: pick the provider in Admin > Settings > AI (or force it here: claude | openrouter)
# AI_PROVIDER=claude
ANTHROPIC_API_KEY=<Claude API key from platform.claude.com, can also be set via Admin > Settings > AI>
OPENROUTER_API_KEY=<OpenRouter key, can also be set via Admin > Settings > AI>
ENCRYPTION_KEY=<run: openssl rand -hex 32 — used to encrypt API keys stored in DB>
VERCEL_TOKEN=<Vercel deploy token>

# Optional — enables distributed rate limiting across Vercel instances.
# Without these, rate limiting is per-instance only (not safe for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — HMAC key for newsletter unsubscribe links. Falls back to
# NEXTAUTH_SECRET when unset. Set a dedicated value so rotating the auth
# secret does not break old unsubscribe links.
NEWSLETTER_UNSUB_SECRET=

# --- Newsletter (see Admin > Newsletter > Setup checklist) ---
# Sender for newsletters on a subdomain verified in Resend (SPF, DKIM, DMARC in Infomaniak DNS)
NEWSLETTER_FROM_EMAIL=Riyad Ketami <news@news.ketami.net>
# Optional: where replies go (default riyad@ketami.net) and the footer postal address
# (both can also be set in Admin > Newsletter > Settings)
NEWSLETTER_REPLY_TO=
NEWSLETTER_POSTAL_ADDRESS=
# Signing secret of the Resend webhook pointing at /api/newsletter/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Vercel Cron sends it as a Bearer token to /api/cron/newsletter (daily)
CRON_SECRET=
# Optional transactional email budget for the daily job (Resend Free: 100/day total)
NEWSLETTER_DAILY_EMAIL_CAP=80
# Optional Cloudflare Turnstile on the signup form (both keys, or leave empty)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional legacy Kit mirror (off unless KIT_SYNC_ENABLED=true)
KIT_SYNC_ENABLED=false
KIT_API_KEY=
